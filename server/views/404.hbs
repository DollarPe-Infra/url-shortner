{{> header}}
<div id="notfound" class="section-container not-found-glitch" data-not-found-glitch>
  <div class="not-found-glitch__stage">
    <div class="not-found-glitch__code-group">
      <span class="not-found-glitch__ghost not-found-glitch__ghost--red" aria-hidden="true" data-glitch-text="404">404</span>
      <span class="not-found-glitch__ghost not-found-glitch__ghost--cyan" aria-hidden="true" data-glitch-text="404">404</span>
      <h1 class="not-found-glitch__code" data-glitch-text="404">404</h1>
    </div>
    <div class="not-found-glitch__copy">
      <p class="not-found-glitch__title">Link not found</p>
      <p class="not-found-glitch__desc">This short link moved, expired, or never existed.</p>
    </div>
    <a class="button primary" href="/admin">Back to dashboard</a>
  </div>
</div>
{{> footer}}
