{{> header}}
<section
  id="stats-section"
  class="stats-page"
  hx-get="/api/links/{id}/stats"
  hx-swap="innerHTML"
  hx-trigger="load once"
  hx-vals='js:{ id: getQueryParams().id || "" }'
  hx-ext="path-params"
  hx-on::after-swap="initStatsDashboard();"
>
  <div class="loading-stats">
    {{> icons/spinner}}
    Loading stats...
  </div>
</section>
{{#extend "stylesheets"}}
  <link rel="stylesheet" href="/css/stats-dashboard.css">
{{/extend}}
{{#extend "scripts"}}
  <script src="/libs/chart.min.js"></script>
  <script src="/scripts/stats.js"></script>
{{/extend}}
